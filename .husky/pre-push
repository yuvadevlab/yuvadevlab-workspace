#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running quality checks before push..."

pnpm run lint

if git rev-parse --verify origin/main >/dev/null 2>&1; then
  echo "🔎 Running affected tests against origin/main..."
  pnpm nx affected -t test --base=origin/main --head=HEAD --parallel=3
else
  echo "⚠️ origin/main not found; falling back to a full test run."
  pnpm nx run-many -t test --all --coverage
fi

echo "✅ Quality checks passed."
